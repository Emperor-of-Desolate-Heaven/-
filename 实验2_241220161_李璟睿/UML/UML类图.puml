@startuml 系统类图
title 系统类图（结构性图）

enum Role {
  创建者
  超级管理员
  管理员
  普通用户
}

enum RecordStatus {
  待审核
  已生效
  已驳回
  已删除
}

enum LogOpType {
  加入
  删除
  修改
  审核失败
}

class 用户 {
  -用户ID : int
  -用户名 : string
  -密码 : string
  +登录()
  +注册()
}

class 账本 {
  -账本ID : int
  -名称 : string
  -生效时间 : datetime
  +创建账本()
}

class 场景模板 {
  -模板类型 : string
  -默认类别 : list
  -结算方式 : string
  -预算口径 : string
}

class 成员关系 {
  -角色 : Role
  -加入时间 : datetime
  -可见性设置 : bool
  +申请加入()
  +退出()
  +转让记录()
}

class 收支记录 {
  -记录ID : int
  -原因 : string
  -金额 : decimal
  -时间 : datetime
  -支付凭证 : string
  -状态 : RecordStatus
  +提交()
  +审核()
  +驳回()
  +重新提交()
  +修改金额()
  +删除()
  +转让()
}

class 分摊明细 {
  -参与人 : 用户
  -比例 : float
}

class 操作日志 {
  -日志ID : int
  -操作类型 : LogOpType
  -审核人 : 用户
  -提交人 : 用户
  -日期 : datetime
  -类别 : string
}

class 日志访问授权 {
  -成员 : 成员关系
  -授权管理员 : 用户
  -授权时间 : datetime
  -已使用 : bool
  +审批()
  +校验一次有效()
}

class 预算 {
  -金额 : decimal
  -是否启用 : bool
  +计算红绿灯等级()
}

class 结算 {
  -结算ID : int
  -结算时间点 : datetime
  -周期 : string
  -结果 : string
  +按模板结算()
}

用户 "1" -- "*" 成员关系 : 加入
账本 "1" -- "*" 成员关系 : 拥有
账本 "1" -- "1" 场景模板 : 使用模板
账本 "1" *-- "*" 收支记录 : 包含
用户 "1" -- "*" 收支记录 : 上传人
收支记录 "1" *-- "*" 分摊明细 : 包含
用户 "1" -- "*" 分摊明细 : 参与人
账本 "1" -- "0..1" 预算 : 设置
账本 "1" -- "*" 结算 : 生成
账本 "1" -- "*" 操作日志 : 记录
成员关系 "*" -- "*" 日志访问授权 : 申请
用户 "1" -- "*" 日志访问授权 : 授权

成员关系 ..> Role
收支记录 ..> RecordStatus
操作日志 ..> LogOpType

note right of 预算
  红绿灯规则：
  总支出 < 预算80% 绿色
  80% ~ 100% 黄色
  > 100% 红色
end note

@enduml
